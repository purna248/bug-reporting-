<!doctype html><html><head><meta charset=utf8><meta name=viewport content="width=device-width,initial-scale=1,viewport-fit=cover"><style>:root{color-scheme:light;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}html{scroll-padding-top:env(safe-area-inset-top,0px)}body{margin:0;padding:0;font:14px -apple-system,BlinkMacSystemFont,sans-serif;background:#fff;color:#000}img{max-width:100%}[hidden]:not([hidden=until-found i]){display:none!important}</style></head><body>
<title>Bug Report Builder</title>
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600&display=swap">
<style>
/* Layout: two-pane workbench. Form on the left, a live A4-style paper preview on the right (stacked on phones). */
:root {
  --bg: #F2F5F6;
  --surface: #FFFFFF;
  --surface-2: #E8EDEF;
  --line: #D3DCDF;
  --text: #13232A;
  --muted: #566972;
  --accent: #0B6E79;
  --accent-soft: #DCEEF0;
  --accent-ink: #FFFFFF;
  --focus: #0B6E79;
  --p1: #B42318; --p1-bg: #FEE4E2;
  --p2: #B54708; --p2-bg: #FEF0C7;
  --p3: #175CD3; --p3-bg: #D1E9FF;
  --p4: #475467; --p4-bg: #EAECF0;
  --danger: #B42318;
  --font-ui: 'IBM Plex Sans', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
  --font-mono: 'IBM Plex Mono', ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --bg: #0E1A1F;
    --surface: #15252B;
    --surface-2: #1C2F36;
    --line: #2B3F47;
    --text: #E4EDEF;
    --muted: #95A8B0;
    --accent: #4DC0CB;
    --accent-soft: #12353B;
    --accent-ink: #06242A;
    --focus: #4DC0CB;
    --p1: #FDA29B; --p1-bg: #3A1714;
    --p2: #FEC84B; --p2-bg: #3B2A0B;
    --p3: #84CAFF; --p3-bg: #0F2A47;
    --p4: #CBD2DC; --p4-bg: #2A323C;
    --danger: #FDA29B;
    color-scheme: dark;
  }
}
:root[data-theme="dark"] {
  --bg: #0E1A1F;
  --surface: #15252B;
  --surface-2: #1C2F36;
  --line: #2B3F47;
  --text: #E4EDEF;
  --muted: #95A8B0;
  --accent: #4DC0CB;
  --accent-soft: #12353B;
  --accent-ink: #06242A;
  --focus: #4DC0CB;
  --p1: #FDA29B; --p1-bg: #3A1714;
  --p2: #FEC84B; --p2-bg: #3B2A0B;
  --p3: #84CAFF; --p3-bg: #0F2A47;
  --p4: #CBD2DC; --p4-bg: #2A323C;
  --danger: #FDA29B;
  color-scheme: dark;
}

* { box-sizing: border-box; }
body {
  background: var(--bg);
  color: var(--text);
  font: 14px/1.5 var(--font-ui);
  padding-block: 24px 40px;
  padding-left: max(16px, env(safe-area-inset-left, 0px));
  padding-right: max(16px, env(safe-area-inset-right, 0px));
}
.app { max-width: 1240px; margin: 0 auto; }
.top { margin-bottom: 20px; }
.top .kicker { font: 600 11px/1 var(--font-mono); letter-spacing: .14em; color: var(--accent); margin: 0 0 8px; }
.top h1 { font-size: 26px; line-height: 1.2; margin: 0 0 6px; font-weight: 600; text-wrap: balance; }
.top p { margin: 0; color: var(--muted); max-width: 62ch; }

.workbench { display: grid; grid-template-columns: minmax(0, 1fr); gap: 20px; align-items: start; }
@media (min-width: 980px) {
  .workbench { grid-template-columns: minmax(0, 460px) minmax(0, 1fr); }
  .preview-pane { position: sticky; top: 16px; max-height: calc(100vh - 32px); display: flex; flex-direction: column; }
  .preview-pane .paper-wrap { overflow: auto; flex: 1 1 auto; min-height: 0; }
}

.form-pane { background: var(--surface); border: 1px solid var(--line); border-radius: 8px; padding: 18px; min-width: 0; }
.preview-pane { min-width: 0; }

.form-tools { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; justify-content: space-between; margin-bottom: 14px; padding-bottom: 14px; border-bottom: 1px solid var(--line); }
.form-tools p { margin: 0; color: var(--muted); font-size: 13px; flex: 1 1 200px; }
.form-tools .btns { display: flex; gap: 8px; }

.grp { margin: 0 0 22px; min-width: 0; }
.grp:last-child { margin-bottom: 0; }
.grp h2 { font: 600 12px/1 var(--font-mono); letter-spacing: .1em; text-transform: uppercase; color: var(--accent); margin: 0 0 12px; }
.field { margin: 0 0 12px; min-width: 0; }
.field > label, .field > .lbl { display: block; font-size: 12px; font-weight: 500; color: var(--muted); margin-bottom: 5px; }
.hint { font-size: 12px; color: var(--muted); margin: 6px 0 0; }
.row2 { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 12px; }
.row2 .field { margin-bottom: 0; }
.row2 + .field, .row2 + .row2 { margin-top: 12px; }

input[type="text"], input[type="date"], select, textarea {
  width: 100%;
  background: var(--surface);
  color: var(--text);
  border: 1px solid var(--line);
  border-radius: 6px;
  padding: 9px 10px;
  font: inherit;
  min-width: 0;
}
textarea { resize: vertical; min-height: 84px; line-height: 1.45; }
input::placeholder, textarea::placeholder { color: var(--muted); opacity: .8; }
input:focus-visible, select:focus-visible, textarea:focus-visible, .btn:focus-visible {
  outline: 2px solid var(--focus); outline-offset: 1px;
}
.mono { font-family: var(--font-mono); font-size: 13px; }

.chips { display: grid; grid-template-columns: repeat(auto-fit, minmax(96px, 1fr)); gap: 8px; }
.chip { position: relative; display: block; cursor: pointer; --c: var(--accent); --c-bg: var(--accent-soft); }
.chip input { position: absolute; inset: 0; opacity: 0; margin: 0; cursor: pointer; }
.chip-body { display: flex; flex-direction: column; gap: 2px; height: 100%; padding: 9px 10px; border: 1px solid var(--line); border-radius: 6px; background: var(--surface); }
.chip-body b { font: 600 12px/1.2 var(--font-mono); color: var(--c); }
.chip-body .nm { font-weight: 600; }
.chip-body small { color: var(--muted); font-size: 12px; line-height: 1.3; }
.chip:hover .chip-body { border-color: var(--muted); }
.chip input:checked + .chip-body { border-color: var(--c); background: var(--c-bg); box-shadow: inset 0 0 0 1px var(--c); }
.chip input:focus-visible + .chip-body { outline: 2px solid var(--focus); outline-offset: 2px; }
.chip.p1 { --c: var(--p1); --c-bg: var(--p1-bg); }
.chip.p2 { --c: var(--p2); --c-bg: var(--p2-bg); }
.chip.p3 { --c: var(--p3); --c-bg: var(--p3-bg); }
.chip.p4 { --c: var(--p4); --c-bg: var(--p4-bg); }

.sev-list { display: flex; flex-direction: column; gap: 8px; }
.sev-row { position: relative; display: block; cursor: pointer; }
.sev-row input { position: absolute; inset: 0; opacity: 0; margin: 0; cursor: pointer; }
.sev-body { display: grid; grid-template-columns: 30px minmax(0, 1fr); gap: 12px; align-items: start; padding: 10px 12px; border: 1px solid var(--line); border-radius: 6px; background: var(--surface); }
.sev-row:hover .sev-body { border-color: var(--muted); }
.sev-row input:checked + .sev-body { border-color: var(--accent); background: var(--accent-soft); box-shadow: inset 0 0 0 1px var(--accent); }
.sev-row input:focus-visible + .sev-body { outline: 2px solid var(--focus); outline-offset: 2px; }
.meter { display: flex; align-items: flex-end; gap: 3px; height: 22px; padding-top: 2px; }
.meter i { display: block; width: 5px; border-radius: 1px; background: var(--line); }
.meter i:nth-child(1) { height: 6px; }
.meter i:nth-child(2) { height: 10px; }
.meter i:nth-child(3) { height: 15px; }
.meter i:nth-child(4) { height: 20px; }
.meter i.on { background: var(--accent); }
.sev-body .nm { display: block; font-weight: 600; }
.sev-body .ds { display: block; font-size: 13px; }
.sev-body .ex { display: block; margin-top: 2px; font-size: 12px; color: var(--muted); }

.drop { display: block; border: 1.5px dashed var(--line); border-radius: 8px; padding: 18px 14px; text-align: center; cursor: pointer; background: var(--surface); color: var(--muted); }
.drop:hover, .drop.over, .drop:focus-within { border-color: var(--accent); background: var(--accent-soft); color: var(--text); }
.drop strong { color: var(--text); font-weight: 600; }
.drop small { display: block; margin-top: 4px; font-size: 12px; }
.sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
.shot-msg { font-size: 12px; color: var(--danger); margin: 8px 0 0; min-height: 0; }
.shots { list-style: none; margin: 12px 0 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }
.shot { display: grid; grid-template-columns: 84px minmax(0, 1fr) auto; gap: 10px; align-items: center; border: 1px solid var(--line); border-radius: 6px; padding: 8px; background: var(--surface); }
.shot img { width: 84px; height: 58px; object-fit: cover; border-radius: 4px; border: 1px solid var(--line); display: block; }
.shot .cap { min-width: 0; }
.shot .nm { font: 400 11px/1.3 var(--font-mono); color: var(--muted); margin-bottom: 4px; overflow-wrap: anywhere; }
@media (max-width: 420px) {
  .shot { grid-template-columns: 64px minmax(0, 1fr); }
  .shot img { width: 64px; height: 48px; }
  .shot .btn { grid-column: 1 / -1; }
}

.btn { font: 500 13px/1 var(--font-ui); padding: 10px 14px; border-radius: 6px; border: 1px solid var(--line); background: var(--surface); color: var(--text); cursor: pointer; }
.btn:hover:not(:disabled) { border-color: var(--muted); }
.btn.primary { background: var(--accent); border-color: var(--accent); color: var(--accent-ink); }
.btn.primary:hover:not(:disabled) { filter: brightness(1.08); }
.btn.small { padding: 7px 10px; font-size: 12px; }
.btn:disabled { opacity: .5; cursor: not-allowed; }

.pv-head { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; justify-content: space-between; margin-bottom: 10px; }
.pv-head h2 { font: 600 12px/1 var(--font-mono); letter-spacing: .1em; text-transform: uppercase; color: var(--accent); margin: 0; }
.pv-actions { display: flex; flex-wrap: wrap; gap: 8px; }
.dl-status { font-size: 12px; color: var(--muted); min-height: 18px; margin: 0 0 10px; }
.paper-wrap { background: var(--surface-2); border: 1px solid var(--line); border-radius: 8px; padding: 16px; overflow-x: auto; }
.paper { box-shadow: 0 1px 2px rgba(0,0,0,.12), 0 6px 18px rgba(0,0,0,.10); min-width: 0; }

@media (prefers-reduced-motion: reduce) { * { transition: none !important; scroll-behavior: auto !important; } }
@media (max-width: 520px) { .paper-wrap { padding: 10px; } .form-pane { padding: 14px; } }
</style>

<div class="app">
  <header class="top">
    <p class="kicker">BUG REPORT BUILDER</p>
    <h1>Write the report once, hand over a clean document</h1>
    <p>Fill in the details, set the priority, add screenshots, and download a formatted report as PDF or Word. The preview updates as you type.</p>
  </header>

  <div class="workbench">
    <form id="form" class="form-pane" novalidate autocomplete="off">
      <div class="form-tools">
        <p>Fields start with an example report so you can see the result.</p>
        <div class="btns">
          <button type="button" class="btn small" id="btn-example">Load example</button>
          <button type="button" class="btn small" id="btn-blank">Start blank</button>
        </div>
      </div>

      <section class="grp">
        <h2>Report</h2>
        <div class="field">
          <label for="f-title">Title</label>
          <input type="text" id="f-title" maxlength="160" placeholder="Short, specific summary of the problem">
        </div>
        <div class="row2">
          <div class="field">
            <label for="f-id">Report ID</label>
            <input type="text" id="f-id" class="mono" maxlength="40">
          </div>
          <div class="field">
            <label for="f-date">Date reported</label>
            <input type="date" id="f-date">
          </div>
        </div>
        <div class="field">
          <label for="f-reporter">Reported by</label>
          <input type="text" id="f-reporter" maxlength="80" placeholder="Your name or team">
        </div>
      </section>

      <section class="grp">
        <h2>Priority and severity</h2>
        <div class="field">
          <span class="lbl" id="lbl-priority">Priority: how soon should this be fixed?</span>
          <div class="chips" id="priority-group" role="radiogroup" aria-labelledby="lbl-priority"></div>
        </div>
        <div class="field">
          <span class="lbl" id="lbl-severity">Severity: how much does this bug hurt users?</span>
          <div class="sev-list" id="severity-group" role="radiogroup" aria-labelledby="lbl-severity"></div>
          <p class="hint">More filled bars means more impact on users. Not sure? Pick Major if a main feature is broken, or Minor if users can work around it. Severity is about impact, while Priority (above) is about urgency, so a cosmetic bug on the home page can still be high priority.</p>
        </div>
        <div class="field">
          <label for="f-frequency">How often does it happen?</label>
          <select id="f-frequency">
            <option value="">Select…</option>
            <option>Always</option>
            <option>Often</option>
            <option>Sometimes</option>
            <option>Once</option>
          </select>
        </div>
      </section>

      <section class="grp">
        <h2>Environment</h2>
        <div class="row2">
          <div class="field">
            <label for="f-product">App or product</label>
            <input type="text" id="f-product" maxlength="80">
          </div>
          <div class="field">
            <label for="f-version">Version or build</label>
            <input type="text" id="f-version" maxlength="60">
          </div>
        </div>
        <div class="row2">
          <div class="field">
            <label for="f-os">Operating system or device</label>
            <input type="text" id="f-os" maxlength="80">
          </div>
          <div class="field">
            <label for="f-browser">Browser</label>
            <input type="text" id="f-browser" maxlength="80">
          </div>
        </div>
      </section>

      <section class="grp">
        <h2>What happened</h2>
        <div class="field">
          <label for="f-steps">Steps to reproduce (one step per line)</label>
          <textarea id="f-steps" rows="5"></textarea>
        </div>
        <div class="field">
          <label for="f-expected">Expected behavior</label>
          <textarea id="f-expected" rows="3"></textarea>
        </div>
        <div class="field">
          <label for="f-actual">Actual behavior</label>
          <textarea id="f-actual" rows="3"></textarea>
        </div>
        <div class="field">
          <label for="f-notes">Additional notes (workarounds, logs, when it started)</label>
          <textarea id="f-notes" rows="3"></textarea>
        </div>
      </section>

      <section class="grp">
        <h2>Screenshots</h2>
        <label class="drop" id="drop" for="f-shots">
          <input type="file" id="f-shots" class="sr-only" accept="image/*" multiple>
          <strong>Drop screenshots here</strong>, click to choose, or paste with Ctrl+V
          <small>PNG, JPG or WebP. Images wider than 1600 px are resized.</small>
        </label>
        <p class="shot-msg" id="shot-msg" role="status"></p>
        <ul class="shots" id="shots"></ul>
      </section>
    </form>

    <section class="preview-pane" aria-label="Report preview">
      <div class="pv-head">
        <h2>Document preview</h2>
        <div class="pv-actions">
          <button type="button" class="btn primary" id="btn-pdf" disabled>Download PDF</button>
          <button type="button" class="btn" id="btn-word" disabled>Download Word document</button>
        </div>
      </div>
      <p class="dl-status" id="dl-status" role="status">Checking download support…</p>
      <div class="paper-wrap">
        <div class="paper" id="paper"></div>
      </div>
    </section>
  </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
<script>
(function () {
  'use strict';

  var $ = function (id) { return document.getElementById(id); };

  var PRI = {
    P1: { name: 'Critical', when: 'Fix now' },
    P2: { name: 'High', when: 'This sprint' },
    P3: { name: 'Medium', when: 'Next release' },
    P4: { name: 'Low', when: 'When time allows' }
  };
  var SEV = {
    Blocker: { level: 4, short: 'users cannot continue', desc: 'Users cannot use the app or finish a key task.', example: 'The app crashes on start, or nobody can sign in.' },
    Major: { level: 3, short: 'main feature broken', desc: 'A main feature is broken and there is no easy workaround.', example: 'Payment fails, or a file will not upload.' },
    Minor: { level: 2, short: 'workaround exists', desc: 'Something is wrong, but users can work around it.', example: 'A filter resets after refresh, so users set it again.' },
    Cosmetic: { level: 1, short: 'looks wrong only', desc: 'It looks wrong, but everything still works.', example: 'A typo, a misaligned button, or the wrong color.' }
  };

  var DOC_CSS = [
    ".doc{background:#fff;color:#14202B;font:14px/1.55 'IBM Plex Sans',system-ui,-apple-system,'Segoe UI',Arial,sans-serif;padding:36px 40px}",
    ".doc *{box-sizing:border-box}",
    ".doc .d-top{display:flex;justify-content:space-between;gap:12px;align-items:baseline;flex-wrap:wrap;border-bottom:2px solid #0B6E79;padding-bottom:10px}",
    ".doc .d-kicker{font:600 11px/1 'IBM Plex Mono',ui-monospace,Menlo,monospace;letter-spacing:.14em;color:#0B6E79}",
    ".doc .d-id{font:500 12px/1.2 'IBM Plex Mono',ui-monospace,Menlo,monospace;color:#5B6875;overflow-wrap:anywhere}",
    ".doc h1{font-size:24px;line-height:1.25;margin:18px 0 12px;font-weight:600;overflow-wrap:anywhere;color:#14202B}",
    ".doc .d-badges{display:flex;flex-wrap:wrap;gap:8px;margin:0 0 18px}",
    ".doc .pill{display:inline-block;padding:3px 10px;border-radius:4px;border:1px solid #D9DFE5;font-size:12px;font-weight:600;color:#14202B;background:#fff}",
    ".doc .pill.p1{background:#FEE4E2;border-color:#FDA29B;color:#B42318}",
    ".doc .pill.p2{background:#FEF0C7;border-color:#FEC84B;color:#B54708}",
    ".doc .pill.p3{background:#D1E9FF;border-color:#84CAFF;color:#175CD3}",
    ".doc .pill.p4{background:#EAECF0;border-color:#D0D5DD;color:#475467}",
    ".doc table.d-meta{width:100%;border-collapse:collapse;margin:0 0 4px;border-bottom:1px solid #D9DFE5}",
    ".doc .d-meta th{text-align:left;width:128px;font:500 11px/1.6 'IBM Plex Mono',ui-monospace,Menlo,monospace;letter-spacing:.06em;text-transform:uppercase;color:#5B6875;padding:8px 12px 8px 0;border-top:1px solid #D9DFE5;vertical-align:top}",
    ".doc .d-meta td{padding:8px 0;border-top:1px solid #D9DFE5;overflow-wrap:anywhere}",
    ".doc h2{font:600 12px/1.2 'IBM Plex Mono',ui-monospace,Menlo,monospace;letter-spacing:.1em;text-transform:uppercase;color:#0B6E79;margin:24px 0 8px}",
    ".doc p{margin:0;white-space:pre-wrap;overflow-wrap:anywhere}",
    ".doc ol{margin:0;padding-left:22px}",
    ".doc li{margin:0 0 4px;padding-left:4px;overflow-wrap:anywhere}",
    ".doc figure{margin:0 0 18px;break-inside:avoid}",
    ".doc figure img{display:block;max-width:100%;height:auto;border:1px solid #D9DFE5}",
    ".doc figcaption{font-size:12px;color:#5B6875;margin-top:6px;overflow-wrap:anywhere}",
    ".doc .d-empty{border:1px dashed #C5CDD5;color:#7A8794;padding:18px;text-align:center;font-size:13px}",
    ".doc .d-foot{margin-top:28px;padding-top:10px;border-top:1px solid #D9DFE5;font:12px/1.4 'IBM Plex Mono',ui-monospace,Menlo,monospace;color:#5B6875}",
    "@media (max-width:520px){.doc{padding:22px 18px}.doc h1{font-size:20px}.doc .d-meta th{width:96px}}"
  ].join('\n');

  var docStyle = document.createElement('style');
  docStyle.textContent = DOC_CSS;
  document.head.appendChild(docStyle);

  var state = { shots: [] };
  var shotSeq = 0;
  var MAX_SHOTS = 12;
  var downloads = null;
  var downloadsChecked = false;

  function esc(s) {
    return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
  }
  function pad(n) { return (n < 10 ? '0' : '') + n; }
  function todayISO() {
    var d = new Date();
    return d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate());
  }
  function defaultId() { return 'BUG-' + todayISO().replace(/-/g, '') + '-001'; }
  function fmtDate(v) {
    if (!v) return '';
    var p = v.split('-');
    if (p.length !== 3) return v;
    var d = new Date(+p[0], +p[1] - 1, +p[2]);
    if (isNaN(d.getTime())) return v;
    return d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
  }
  function slug(s) {
    var out = String(s || 'bug-report').replace(/[^A-Za-z0-9._-]+/g, '-').replace(/^-+|-+$/g, '');
    return out || 'bug-report';
  }

  /* ---------- choice chips ---------- */
  function buildChips(containerId, name, items, kind) {
    var host = $(containerId);
    Object.keys(items).forEach(function (key) {
      var label = document.createElement('label');
      label.className = kind === 'pri' ? 'chip ' + key.toLowerCase() : 'sev-row';
      var input = document.createElement('input');
      input.type = 'radio';
      input.name = name;
      input.value = key;
