  /* ---------- screenshots ---------- */
  function shotMsg(t) { $('shot-msg').textContent = t || ''; }

  function processImage(file) {
    return new Promise(function (resolve, reject) {
      var fr = new FileReader();
      fr.onerror = function () { reject(fr.error); };
      fr.onload = function () {
        var img = new Image();
        img.onerror = function () { reject(new Error('decode')); };
        img.onload = function () {
          var max = 1600;
          var sc = Math.min(1, max / img.naturalWidth);
          var w = Math.max(1, Math.round(img.naturalWidth * sc));
          var h = Math.max(1, Math.round(img.naturalHeight * sc));
          var c = document.createElement('canvas');
          c.width = w; c.height = h;
          var x = c.getContext('2d');
          x.fillStyle = '#ffffff';
          x.fillRect(0, 0, w, h);
          x.drawImage(img, 0, 0, w, h);
          shotSeq += 1;
          resolve({ id: shotSeq, name: file.name || ('pasted-' + shotSeq + '.png'), url: c.toDataURL('image/jpeg', 0.9), w: w, h: h, caption: '' });
        };
        img.src = fr.result;
      };
      fr.readAsDataURL(file);
    });
  }

  function addFiles(list) {
    var files = Array.prototype.slice.call(list || []).filter(function (f) { return f.type && f.type.indexOf('image/') === 0; });
    if (!files.length) { shotMsg('Only image files can be added.'); return Promise.resolve(); }
    shotMsg('');
    var chain = Promise.resolve();
    files.forEach(function (f) {
      chain = chain.then(function () {
        if (state.shots.length >= MAX_SHOTS) { shotMsg('A report can hold up to ' + MAX_SHOTS + ' screenshots.'); return; }
        return processImage(f).then(function (s) { state.shots.push(s); }).catch(function () { shotMsg('Could not read ' + (f.name || 'that image') + '.'); });
      });
    });
    return chain.then(function () { renderShots(); render(); });
  }

  function renderShots() {
    var ul = $('shots');
    ul.textContent = '';
    state.shots.forEach(function (s, i) {
      var li = document.createElement('li');
      li.className = 'shot';
      var img = document.createElement('img');
      img.src = s.url;
      img.alt = 'Screenshot ' + (i + 1) + ' thumbnail';
      var cap = document.createElement('div');
      cap.className = 'cap';
      var nm = document.createElement('div');
      nm.className = 'nm';
      nm.textContent = 'Figure ' + (i + 1) + ' · ' + s.name;
      var inp = document.createElement('input');
      inp.type = 'text';
      inp.id = 'cap-' + s.id;
      inp.maxLength = 200;
      inp.value = s.caption;
      inp.placeholder = 'Caption (optional)';
      inp.setAttribute('aria-label', 'Caption for screenshot ' + (i + 1));
      inp.addEventListener('input', function () { s.caption = inp.value.trim(); render(); });
      cap.appendChild(nm);
      cap.appendChild(inp);
      var rm = document.createElement('button');
      rm.type = 'button';
      rm.className = 'btn small';
      rm.textContent = 'Remove';
      rm.addEventListener('click', function () {
        state.shots = state.shots.filter(function (x) { return x.id !== s.id; });
        shotMsg('');
        renderShots();
        render();
      });
      li.appendChild(img);
      li.appendChild(cap);
      li.appendChild(rm);
      ul.appendChild(li);
    });
  }

