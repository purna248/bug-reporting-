  /* ---------- PDF ---------- */
  function buildPdf(d) {
    var J = window.jspdf && window.jspdf.jsPDF;
    if (!J) throw new Error('PDF library missing');
    var doc = new J({ unit: 'mm', format: 'a4', compress: true });
    var replaced = 0;
    function safe(s) {
      var out = String(s).replace(/\t/g, '    ').replace(/\r/g, '')
        .replace(/[‘’]/g, "'").replace(/[“”]/g, '"')
        .replace(/[–—]/g, '-').replace(/…/g, '...')
        .replace(/•/g, '-').replace(/ /g, ' ').replace(/·/g, '|');
      return out.replace(/[^\n\x20-\x7E\xA1-\xFF]/g, function () { replaced += 1; return '?'; });
    }
    var W = 210, H = 297, M = 18, CW = W - 2 * M, BOTTOM = H - 20;
    var PT = 0.3528;
    var teal = [11, 110, 121], ink = [20, 32, 43], sub = [91, 104, 117], rule = [217, 223, 229];
    var y = M;

    function ensure(hh) { if (y + hh > BOTTOM) { doc.addPage(); y = M; } }
    function setText(c) { doc.setTextColor(c[0], c[1], c[2]); }
    function para(text, size, x, width, color, style, lh) {
      doc.setFont('helvetica', style || 'normal');
      doc.setFontSize(size);
      setText(color);
      var lineH = lh || size * PT * 1.5;
      var rows = safe(text).split('\n');
      rows.forEach(function (row) {
        var lines = row === '' ? [''] : doc.splitTextToSize(row, width);
        lines.forEach(function (l) {
          ensure(lineH);
          doc.text(l, x, y + size * PT * 0.85);
          y += lineH;
        });
      });
    }
    function heading(t) {
      ensure(18);
      y += 7;
      doc.setFont('helvetica', 'bold');
      doc.setFontSize(9);
      setText(teal);
      doc.text(t.toUpperCase(), M, y + 3, { charSpace: 0.5 });
      y += 7;
    }

    // top line
    doc.setFont('helvetica', 'bold');
    doc.setFontSize(9);
    setText(teal);
    doc.text('BUG REPORT', M, y + 3, { charSpace: 0.8 });
    doc.setFont('courier', 'normal');
    doc.setFontSize(9);
    setText(sub);
    doc.text(safe(d.id + (d.date ? '  |  ' + fmtDate(d.date) : '')), W - M, y + 3, { align: 'right' });
    y += 6;
    doc.setDrawColor(teal[0], teal[1], teal[2]);
    doc.setLineWidth(0.7);
    doc.line(M, y, W - M, y);
    y += 8;

    // title
    para(d.title || 'Untitled bug report', 18, M, CW, ink, 'bold', 8);
    y += 3;

    // badges
    var PILL = {
      p1: { fill: [254, 228, 226], stroke: [253, 162, 155], txt: [180, 35, 24] },
      p2: { fill: [254, 240, 199], stroke: [254, 200, 75], txt: [181, 71, 8] },
      p3: { fill: [209, 233, 255], stroke: [132, 202, 255], txt: [23, 92, 211] },
      p4: { fill: [234, 236, 240], stroke: [208, 213, 221], txt: [71, 84, 103] },
      neutral: { fill: [255, 255, 255], stroke: rule, txt: ink }
    };
    var bl = badges(d);
    if (bl.length) {
      var bx = M, ph = 6.4;
      doc.setFont('helvetica', 'bold');
      doc.setFontSize(8.5);
      bl.forEach(function (b) {
        var label = safe(b.label);
        var tw = doc.getTextWidth(label);
        var w = tw + 7;
        if (bx + w > W - M) { bx = M; y += ph + 2; }
        var c = PILL[b.cls] || PILL.neutral;
        doc.setFillColor(c.fill[0], c.fill[1], c.fill[2]);
        doc.setDrawColor(c.stroke[0], c.stroke[1], c.stroke[2]);
        doc.setLineWidth(0.25);
        doc.roundedRect(bx, y, w, ph, 1, 1, 'FD');
        setText(c.txt);
        doc.text(label, bx + 3.5, y + 4.3);
        bx += w + 2.5;
      });
      y += ph + 8;
    }

    // meta table
    var rows = metaRows(d);
    if (rows.length) {
      doc.setDrawColor(rule[0], rule[1], rule[2]);
      doc.setLineWidth(0.2);
      rows.forEach(function (r) {
        doc.setFont('helvetica', 'normal');
        doc.setFontSize(10);
        var lines = doc.splitTextToSize(safe(r[1]), CW - 40);
        var hh = lines.length * 5 + 4.5;
        ensure(hh);
        doc.line(M, y, W - M, y);
        doc.setFontSize(7.5);
        setText(sub);
        doc.text(r[0].toUpperCase(), M, y + 5.6, { charSpace: 0.3 });
        doc.setFontSize(10);
        setText(ink);
        doc.text(lines, M + 40, y + 5.2);
        y += hh;
      });
      doc.line(M, y, W - M, y);
    }

    // steps
    if (d.steps.length) {
      heading('Steps to reproduce');
      d.steps.forEach(function (s, i) {
        doc.setFont('helvetica', 'normal');
        doc.setFontSize(10);
        var lines = doc.splitTextToSize(safe(s), CW - 8);
        var hh = lines.length * 5.3;
        ensure(hh);
        doc.setFont('helvetica', 'bold');
        setText(sub);
        doc.text((i + 1) + '.', M, y + 3.6);
        doc.setFont('helvetica', 'normal');
        setText(ink);
        doc.text(lines, M + 8, y + 3.6, { lineHeightFactor: 1.5 });
        y += hh + 1.2;
      });
    }
    if (d.expected) { heading('Expected behavior'); para(d.expected, 10, M, CW, ink); }
    if (d.actual) { heading('Actual behavior'); para(d.actual, 10, M, CW, ink); }

    // screenshots
    if (d.shots.length) {
      heading('Screenshots');
      d.shots.forEach(function (s, i) {
        var maxW = CW, maxH = 120;
        var iw = maxW, ih = iw * (s.h / s.w);
        if (ih > maxH) { ih = maxH; iw = ih * (s.w / s.h); }
        doc.setFont('helvetica', 'normal');
        doc.setFontSize(8.5);
        var capLines = doc.splitTextToSize(safe('Figure ' + (i + 1) + '.' + (s.caption ? ' ' + s.caption : '')), CW);
        var need = ih + capLines.length * 4.2 + 8;
        ensure(need);
        doc.addImage(s.url, 'JPEG', M, y, iw, ih, undefined, 'FAST');
        doc.setDrawColor(rule[0], rule[1], rule[2]);
        doc.setLineWidth(0.25);
        doc.rect(M, y, iw, ih);
        y += ih + 2.5;
        setText(sub);
        doc.text(capLines, M, y + 3, { lineHeightFactor: 1.4 });
        y += capLines.length * 4.2 + 6;
      });
    }

    if (d.notes) { heading('Additional notes'); para(d.notes, 10, M, CW, ink); }

    // footer on every page
    var n = doc.getNumberOfPages();
    for (var p = 1; p <= n; p++) {
      doc.setPage(p);
      doc.setDrawColor(rule[0], rule[1], rule[2]);
      doc.setLineWidth(0.2);
      doc.line(M, H - 13, W - M, H - 13);
      doc.setFont('helvetica', 'normal');
      doc.setFontSize(8);
      setText(sub);
      doc.text(safe(d.id), M, H - 8.5);
      doc.text('Page ' + p + ' of ' + n, W - M, H - 8.5, { align: 'right' });
    }
    return { data: doc.output('arraybuffer'), replaced: replaced };
  }

