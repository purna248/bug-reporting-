    var PILL = {
      p1: { fill: 'FEE4E2', bdr: 'FDA29B', txt: 'B42318' },
      p2: { fill: 'FEF0C7', bdr: 'FEC84B', txt: 'B54708' },
      p3: { fill: 'D1E9FF', bdr: '84CAFF', txt: '175CD3' },
      p4: { fill: 'EAECF0', bdr: 'D0D5DD', txt: '475467' },
      neutral: { fill: 'FFFFFF', bdr: 'C5CDD5', txt: INK }
    };

    var b = '';
    var idLine = d.id + (d.date ? '  |  ' + fmtDate(d.date) : '');
    b += para(run('BUG REPORT', { b: true, color: TEAL, size: 18, spacing: 30 }) + tab() + run(idLine, { color: SUB, size: 18 }), {
      bdrBottom: { sz: 12, color: TEAL }, tabs: '<w:tab w:val="right" w:pos="' + TW + '"/>', after: 120
    });
    b += para(run(d.title || 'Untitled bug report', { b: true, size: 40, color: INK }), { before: 200, after: 160, line: 252 });

    var bl = badges(d);
    if (bl.length) {
      var pr = '';
      bl.forEach(function (x, i) {
        var c = PILL[x.cls] || PILL.neutral;
        pr += run(' ' + x.label + ' ', { b: true, size: 19, color: c.txt, bdr: c.bdr, fill: c.fill });
        if (i < bl.length - 1) pr += run('   ');
      });
      b += para(pr, { after: 240, line: 360 });
    }

    var rows = metaRows(d);
    if (rows.length) {
      var bd = function (n) { return '<w:' + n + ' w:val="single" w:sz="4" w:space="0" w:color="' + RULE + '"/>'; };
      var t = '<w:tbl><w:tblPr><w:tblW w:w="' + TW + '" w:type="dxa"/><w:tblBorders>' + bd('top') + bd('bottom') + bd('insideH') + '</w:tblBorders>' +
        '<w:tblLayout w:type="fixed"/><w:tblCellMar><w:top w:w="70" w:type="dxa"/><w:left w:w="0" w:type="dxa"/><w:bottom w:w="70" w:type="dxa"/><w:right w:w="100" w:type="dxa"/></w:tblCellMar></w:tblPr>' +
        '<w:tblGrid><w:gridCol w:w="2000"/><w:gridCol w:w="' + (TW - 2000) + '"/></w:tblGrid>';
      rows.forEach(function (r) {
        t += '<w:tr><w:tc><w:tcPr><w:tcW w:w="2000" w:type="dxa"/></w:tcPr>' +
          para(run(r[0], { caps: true, color: SUB, size: 16, spacing: 10 }), { after: 0 }) +
          '</w:tc><w:tc><w:tcPr><w:tcW w:w="' + (TW - 2000) + '" w:type="dxa"/></w:tcPr>' +
          para(run(r[1], { size: 21, color: INK }), { after: 0 }) + '</w:tc></w:tr>';
      });
      t += '</w:tbl>';
      b += t;
    }

    if (d.steps.length) {
      b += heading('Steps to reproduce');
      d.steps.forEach(function (s, i) {
        b += para(run((i + 1) + '.', { b: true, size: 21, color: SUB }) + tab() + run(s, { size: 21, color: INK }), {
          ind: '<w:ind w:left="400" w:hanging="400"/>', tabs: '<w:tab w:val="left" w:pos="400"/>', after: 80
        });
      });
    }
    if (d.expected) { b += heading('Expected behavior'); b += text(d.expected); }
    if (d.actual) { b += heading('Actual behavior'); b += text(d.actual); }

    if (d.shots.length) {
      b += heading('Screenshots');
      d.shots.forEach(function (s, i) {
        var n = i + 1;
        var cx = Math.min(TW * 635, s.w * 9525);
        var cy = Math.round(cx * s.h / s.w);
        if (cy > 4300000) { cy = 4300000; cx = Math.round(cy * s.w / s.h); }
        cx = Math.round(cx);
        b += '<w:p><w:pPr><w:keepNext/><w:spacing w:before="60" w:after="60"/></w:pPr>' + drawing(n, cx, cy) + '</w:p>';
        b += para(run('Figure ' + n + '.' + (s.caption ? ' ' + s.caption : ''), { color: SUB, size: 18 }), { after: 240 });
      });
    }
    if (d.notes) { b += heading('Additional notes'); b += text(d.notes); }
    b += para('', { after: 0 });

    var docXml = XMLH + '<w:document ' + NSW + ' ' + NSR +
      ' xmlns:wp="http://schemas.openxmlformats.org/drawingml/2006/wordprocessingDrawing"' +
      ' xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"' +
      ' xmlns:pic="http://schemas.openxmlformats.org/drawingml/2006/picture"><w:body>' + b +
      '<w:sectPr><w:footerReference w:type="default" r:id="rId2"/><w:pgSz w:w="11906" w:h="16838"/>' +
      '<w:pgMar w:top="1134" w:right="1134" w:bottom="1134" w:left="1134" w:header="567" w:footer="567" w:gutter="0"/></w:sectPr></w:body></w:document>';

    var fld = function (instr) {
      return '<w:fldSimple w:instr=" ' + instr + ' "><w:r><w:rPr><w:color w:val="' + SUB + '"/><w:sz w:val="16"/></w:rPr><w:t>1</w:t></w:r></w:fldSimple>';
    };
    var footerXml = XMLH + '<w:ftr ' + NSW + ' ' + NSR + '>' +
      para(run(d.id, { color: SUB, size: 16 }) + tab() + run('Page ', { color: SUB, size: 16 }) + fld('PAGE') + run(' of ', { color: SUB, size: 16 }) + fld('NUMPAGES'), {
        tabs: '<w:tab w:val="right" w:pos="' + TW + '"/>', after: 0
      }).replace('<w:pPr>', '<w:pPr><w:pBdr><w:top w:val="single" w:sz="4" w:space="6" w:color="' + RULE + '"/></w:pBdr>') +
      '</w:ftr>';

    var stylesXml = XMLH + '<w:styles ' + NSW + '><w:docDefaults><w:rPrDefault><w:rPr>' +
      '<w:rFonts w:ascii="Calibri" w:hAnsi="Calibri" w:eastAsia="Calibri" w:cs="Calibri"/><w:sz w:val="21"/><w:szCs w:val="21"/><w:lang w:val="en-GB"/>' +
      '</w:rPr></w:rPrDefault><w:pPrDefault><w:pPr><w:spacing w:after="120" w:line="276" w:lineRule="auto"/></w:pPr></w:pPrDefault></w:docDefaults>' +
      '<w:style w:type="paragraph" w:default="1" w:styleId="Normal"><w:name w:val="Normal"/><w:qFormat/></w:style></w:styles>';

    var REL = 'http://schemas.openxmlformats.org/officeDocument/2006/relationships';
    var docRels = XMLH + '<Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships">' +
      '<Relationship Id="rId1" Type="' + REL + '/styles" Target="styles.xml"/>' +
      '<Relationship Id="rId2" Type="' + REL + '/footer" Target="footer1.xml"/>';
    d.shots.forEach(function (s, i) {
      docRels += '<Relationship Id="rIdImg' + (i + 1) + '" Type="' + REL + '/image" Target="media/image' + (i + 1) + '.jpeg"/>';
    });
    docRels += '</Relationships>';

    var types = XMLH + '<Types xmlns="http://schemas.openxmlformats.org/package/2006/content-types">' +
      '<Default Extension="rels" ContentType="application/vnd.openxmlformats-package.relationships+xml"/>' +
      '<Default Extension="xml" ContentType="application/xml"/>' +
      '<Default Extension="jpeg" ContentType="image/jpeg"/>' +
      '<Override PartName="/word/document.xml" ContentType="application/vnd.openxmlformats-officedocument.wordprocessingml.document.main+xml"/>' +
      '<Override PartName="/word/styles.xml" ContentType="application/vnd.openxmlformats-officedocument.wordprocessingml.styles+xml"/>' +
      '<Override PartName="/word/footer1.xml" ContentType="application/vnd.openxmlformats-officedocument.wordprocessingml.footer+xml"/></Types>';

    var rootRels = XMLH + '<Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships">' +
      '<Relationship Id="rId1" Type="' + REL + '/officeDocument" Target="word/document.xml"/></Relationships>';

    var zip = new window.JSZip();
    zip.file('[Content_Types].xml', types);
    zip.file('_rels/.rels', rootRels);
    zip.file('word/document.xml', docXml);
    zip.file('word/styles.xml', stylesXml);
    zip.file('word/footer1.xml', footerXml);
    zip.file('word/_rels/document.xml.rels', docRels);
    d.shots.forEach(function (s, i) {
      zip.file('word/media/image' + (i + 1) + '.jpeg', s.url.split(',')[1], { base64: true });
    });
    return zip.generateAsync({
      type: 'blob',
      mimeType: 'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
      compression: 'DEFLATE'
    });
  }

  /* ---------- downloads ---------- */
  function status(t) { $('dl-status').textContent = t; }
  function hasPdf() { return !!(window.jspdf && window.jspdf.jsPDF); }
  function hasWord() { return !!window.JSZip; }
  function updateButtons() {
    var ok = !!downloads;
    $('btn-word').disabled = !ok || !hasWord();
    $('btn-pdf').disabled = !ok || !hasPdf();
    if (!downloadsChecked) { status('Checking download support…'); return; }
    if (!ok) { status('Downloads are not available in this view. Open the artifact in claude.ai to save the report.'); return; }
    var missing = [];
    if (!hasPdf()) missing.push('PDF');
    if (!hasWord()) missing.push('Word');
    if (missing.length) { status('The ' + missing.join(' and ') + ' download could not load. Reload the page to try again.'); return; }
    status('Ready. Downloads ask for your confirmation before saving.');
  }
  function explain(e) {
    var code = e && e.code;
    if (code === 'declined') return 'Download cancelled.';
    if (code === 'rate_limited') return 'A download prompt is already open. Answer it, then try again.';
    if (code === 'too_large') return 'The file is too large to save here. Remove a few screenshots and try again.';
    if (code === 'unavailable' || code === 'not_granted' || code === 'capability_disabled' || code === 'capability_removed') return 'Downloads are not available in this view.';
    return 'Could not create the file' + (e && e.message ? ': ' + e.message : '.');
  }
  function download(kind) {
    if (!downloads) return;
    var d = collect();
    var base = slug(d.id);
    var job;
    try {
      if (kind === 'pdf') {
        status('Building PDF…');
        var built = buildPdf(d);
        job = downloads.save({ filename: base + '.pdf', data: built.data }).then(function (r) {
          var note = built.replaced ? ' Some characters outside the standard Latin set were replaced with "?". Use the Word download for other scripts.' : '';
          status((r.status === 'saved' ? 'PDF saved.' : 'PDF sent.') + note);
        });
      } else {
        status('Building Word document…');
        job = buildDocx(d).then(function (blob) {
          return downloads.save({ filename: base + '.docx', data: blob });
        }).then(function (r) {
          status(r.status === 'saved' ? 'Word document saved.' : 'Word document sent.');
        });
      }
    } catch (err) {
      status(explain(err));
      return;
    }
    job.catch(function (err) { status(explain(err)); });
  }
  $('btn-pdf').addEventListener('click', function () { download('pdf'); });
  $('btn-word').addEventListener('click', function () { download('word'); });

  (function resolveDownloads() {
    var p;
    try { p = window.claude && window.claude.use ? window.claude.use('downloads') : Promise.resolve(null); } catch (e) { p = Promise.resolve(null); }
    Promise.resolve(p).then(function (ns) { downloads = ns || null; }).catch(function () { downloads = null; }).then(function () {
      downloadsChecked = true;
      updateButtons();
    });
  })();
  window.addEventListener('load', updateButtons);

  loadExample();
  updateButtons();
})();
</script>

